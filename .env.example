MAX_IMAGE_BYTES=5242880
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/bmp
PART_RECOGNITION_PROVIDER=stub
LOG_LEVEL=INFO

# Flask
FLASK_APP=app.main
FLASK_ENV=production
SECRET_KEY=your-secret-key

# Telegram Bot
BOT_TOKEN=your_bot_token_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Redis
REDIS_URL=redis://redis:6379/0

# Mini App URL (публичный HTTPS)
MINIAPP_URL=https://your-domain.com/miniapp/

# Партнёрские ссылки (заглушки)
OZON_PARTNER_ID=your_ozon_id
WB_PARTNER_ID=your_wb_id

# Logging
LOG_LEVEL=INFO
