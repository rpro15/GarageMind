# ============================================================
# GarageMind AI — .env.example
# Скопируй в .env и заполни
# ============================================================

# === Обязательные ===
SECRET_KEY=your-super-secret-key-change-me
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# === Telegram Bot (опционально) ===
BOT_TOKEN=

# === DeepSeek ===
DEEPSEEK_MODEL=deepseek-chat

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Кэш (TTL в секундах) ===
CACHE_TTL_RECOMMEND=600
CACHE_TTL_BRANDS=3600
CACHE_TTL_MODELS=3600

# === Сборщик знаний ===
COLLECTOR_DAILY_LIMIT=100
AUTO_COLLECTOR_INTERVAL_MINUTES=60
AUTO_COLLECTOR_REVIEWS_PER_CYCLE=10

# === Партнёрские API (опционально) ===
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
WILDBERRIES_API_KEY=

# === URL ===
MINIAPP_URL=https://rpro.su/miniapp/

# === Мониторинг ===
GRAFANA_PASSWORD=admin
PROMETHEUS_ENABLED=true

# === Логирование ===
LOG_LEVEL=INFO

# === Gunicorn ===
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_LOG_LEVEL=info
