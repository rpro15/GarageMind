# ⚠️ Скопируйте этот файл в .env и заполните своими данными
# cp .env.example .env

# Flask
SECRET_KEY=change-me-to-random-secret

# Telegram Bot (получить у @BotFather)
BOT_TOKEN=your-bot-token-here

# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# Redis (опционально)
#REDIS_URL=redis://redis:6379/0

# Mini App URL (публичный HTTPS для Telegram)
MINIAPP_URL=http://localhost:8000/miniapp/

# Партнёрские ссылки (заглушки)
OZON_PARTNER_ID=your_ozon_id
WB_PARTNER_ID=your_wb_id

# Настройки распознавания
MAX_IMAGE_BYTES=5242880
PART_RECOGNITION_PROVIDER=stub

# Логирование
LOG_LEVEL=INFO
